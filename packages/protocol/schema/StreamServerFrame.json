{
  "$id": "StreamServerFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "attached"
        },
        "attachmentId": {
          "type": "string",
          "pattern": "^att_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        "protocolVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "resumeToken": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "attachmentId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lease"
        },
        "driver": {
          "type": "boolean"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "driven": {
          "type": "boolean"
        },
        "driverDevice": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "driver",
        "epoch"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot_start"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot_end"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "input_dropped"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "screen"
        },
        "alternate": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "alternate"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exit"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ended"
        },
        "reason": {
          "type": "string",
          "enum": [
            "evicted_slow",
            "disconnected"
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notice"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ]
    }
  ]
}
