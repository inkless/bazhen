{
  "$id": "LaunchAgentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "compactWindowTokens": {
      "format": "uint32",
      "maximum": 10000000,
      "minimum": 100000,
      "type": "integer"
    },
    "cwd": {
      "minLength": 1,
      "type": "string"
    },
    "harness": {
      "enum": [
        "claude-code",
        "codex"
      ],
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "pattern": "^(?!(?:host|env|agent|task|asgn|attn|ntc|msg|term|dev|att|lease|obs)_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$)[A-Za-z0-9][A-Za-z0-9_-]{0,39}$",
      "type": "string",
      "x-bazhen-message": "a name is 1 to 40 letters, digits, - or _, starts with a letter or digit, and isn't an id"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey",
    "harness",
    "cwd"
  ],
  "type": "object"
}
