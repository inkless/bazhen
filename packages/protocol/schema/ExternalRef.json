{
  "$id": "ExternalRef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "environmentId": {
      "type": "string",
      "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "claude-session",
        "codex-thread"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "environmentId",
    "kind",
    "id"
  ],
  "additionalProperties": false
}
