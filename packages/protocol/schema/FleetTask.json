{
  "$id": "FleetTask",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignmentId": {
      "pattern": "^asgn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "role": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "taskId": {
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "assignmentId",
    "role"
  ],
  "type": "object"
}
