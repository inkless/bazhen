{
  "$id": "FleetAgent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attention": {
      "items": {
        "properties": {
          "id": {
            "pattern": "^attn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "approval",
              "question",
              "failed",
              "undeliverable",
              "escalation",
              "task_done",
              "stuck_starting"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cwd": {
      "type": "string"
    },
    "harness": {
      "enum": [
        "claude-code",
        "codex"
      ],
      "type": "string"
    },
    "headline": {
      "anyOf": [
        {
          "properties": {
            "ageSeconds": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "taskId": {
              "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "taskId",
            "ageSeconds"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "launchedBy": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": [
        "string",
        "null"
      ]
    },
    "listening": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "signal": {
      "anyOf": [
        {
          "properties": {
            "ageSeconds": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "resetsAt": {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "source": {
              "enum": [
                "native",
                "heuristic"
              ],
              "type": "string"
            },
            "value": {
              "enum": [
                "working",
                "waiting_input",
                "needs_approval",
                "idle",
                "done",
                "failed",
                "limited",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "value",
            "source",
            "ageSeconds"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "exited",
        "unknown",
        "lost",
        "closing",
        "closed",
        "failed"
      ],
      "type": "string"
    },
    "tasks": {
      "items": {
        "properties": {
          "assignmentId": {
            "pattern": "^asgn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          },
          "role": {
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "type": "string"
          },
          "taskId": {
            "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "assignmentId",
          "role"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "harness",
    "state",
    "project",
    "cwd",
    "launchedBy",
    "signal",
    "listening",
    "headline",
    "tasks",
    "attention"
  ],
  "type": "object"
}
