{
  "$id": "RuntimeHealthReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "type": "string"
    },
    "state": {
      "enum": [
        "healthy",
        "unreachable",
        "not-running",
        "unused"
      ],
      "type": "string"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "workarounds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "state",
    "version"
  ],
  "type": "object"
}
