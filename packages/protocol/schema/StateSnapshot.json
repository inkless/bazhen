{
  "$id": "StateSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string"
    },
    "eventId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "local",
              "opencode-server"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "environmentId": {
            "type": "string",
            "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex"
            ]
          },
          "project": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "starting",
              "running",
              "exited",
              "unknown",
              "lost",
              "closing",
              "closed",
              "failed"
            ]
          },
          "terminalId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "externalRef": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "environmentId": {
                    "type": "string",
                    "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "claude-session",
                      "codex-thread"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "environmentId",
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "environmentId",
          "harness",
          "project",
          "cwd",
          "state",
          "terminalId",
          "externalRef"
        ],
        "additionalProperties": false
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^attn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "agentId": {
            "type": "string",
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "closeReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answered",
                  "answered_in_tui",
                  "timed_out",
                  "superseded",
                  "agent_closed",
                  "stale"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "agentId",
          "state",
          "closeReason",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "agentId": {
            "type": "string",
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "offered",
              "emitted",
              "seen",
              "queued_in_codex",
              "delivered",
              "undeliverable"
            ]
          }
        },
        "required": [
          "id",
          "agentId",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "epoch",
    "eventId",
    "environments",
    "agents",
    "attention",
    "messages"
  ],
  "additionalProperties": false
}
