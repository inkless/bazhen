{
  "$id": "EventStreamQuery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "after": {
      "type": "string",
      "pattern": "^\\d+$"
    }
  },
  "required": [
    "v",
    "epoch",
    "after"
  ],
  "additionalProperties": false
}
