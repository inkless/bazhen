{
  "$id": "HookRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentId": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "event": {
      "minLength": 1,
      "type": "string"
    },
    "payload": true,
    "pid": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "ppid": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "protocolVersion": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "agentId",
    "event",
    "pid",
    "ppid",
    "payload"
  ],
  "type": "object"
}
