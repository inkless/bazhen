{
  "$id": "ExternalRef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "environmentId": {
      "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "claude-session",
        "codex-thread"
      ],
      "type": "string"
    }
  },
  "required": [
    "environmentId",
    "kind",
    "id"
  ],
  "type": "object"
}
