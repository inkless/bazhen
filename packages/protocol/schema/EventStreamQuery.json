{
  "$id": "EventStreamQuery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "after": {
      "pattern": "^\\d+$",
      "type": "string"
    },
    "epoch": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "epoch",
    "after"
  ],
  "type": "object"
}
