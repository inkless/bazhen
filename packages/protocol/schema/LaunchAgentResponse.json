{
  "$id": "LaunchAgentResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentId": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "eventIds": {
      "items": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "terminalId": {
      "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "agentId",
    "terminalId",
    "eventIds"
  ],
  "type": "object"
}
