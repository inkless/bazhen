{
  "$id": "DelegateTaskRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "fromTaskId": {
      "type": "string",
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "agentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        {
          "type": "string",
          "pattern": "^(?!(?:host|env|agent|task|asgn|attn|ntc|msg|term|dev|att|lease)_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$)[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
        }
      ]
    },
    "launch": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex"
          ]
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^(?!(?:host|env|agent|task|asgn|attn|ntc|msg|term|dev|att|lease)_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$)[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
        }
      },
      "required": [
        "harness"
      ]
    },
    "role": {
      "default": "worker",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "required": [
    "idempotencyKey",
    "title",
    "brief"
  ]
}
