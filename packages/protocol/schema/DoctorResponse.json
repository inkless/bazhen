{
  "$id": "DoctorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "appVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "unreachable",
            "not-running"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "version"
      ]
    },
    "hookClient": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "fallback"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "found": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "found"
      ]
    },
    "agents": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "string",
          "enum": [
            "direct",
            "login"
          ]
        },
        "loginShell": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "shell",
        "loginShell"
      ]
    },
    "codex": {
      "type": "object",
      "properties": {
        "daemon": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "daemon",
        "cli"
      ]
    },
    "web": {
      "type": "object",
      "properties": {
        "externalOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "BAZHEN_EXTERNAL_ORIGINS",
                "config"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "allowInsecureOrigins": {
          "type": "boolean"
        },
        "pairing": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "always"
              ]
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "required"
          ]
        },
        "app": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "externalOrigins",
        "from",
        "allowInsecureOrigins"
      ]
    },
    "notifications": {
      "type": "object",
      "properties": {
        "desktop": {
          "type": "boolean"
        },
        "notifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "desktop",
        "notifier"
      ]
    },
    "env": {
      "type": "object",
      "properties": {
        "capturedAt": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "start",
            "refresh"
          ]
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removed": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "capturedAt",
        "source",
        "kept",
        "removed"
      ]
    }
  },
  "required": [
    "appVersion",
    "protocolVersion",
    "runtime",
    "hookClient",
    "config",
    "agents",
    "env"
  ]
}
