{
  "$id": "HealthResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "appVersion": {
      "type": "string"
    },
    "protocolId": {
      "type": "string"
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "healthy",
              "unreachable",
              "not-running",
              "unused"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "workarounds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "state",
          "version"
        ]
      }
    }
  },
  "required": [
    "status",
    "appVersion",
    "protocolId",
    "runtimes"
  ]
}
