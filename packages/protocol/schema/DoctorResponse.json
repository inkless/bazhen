{
  "$id": "DoctorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "appVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "unreachable",
            "not-running"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "version"
      ]
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "healthy",
              "unreachable",
              "not-running"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "workarounds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "state",
          "version"
        ]
      }
    },
    "hookClient": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "fallback"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "found": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "found"
      ]
    },
    "agents": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "string",
          "enum": [
            "direct",
            "login"
          ]
        },
        "loginShell": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "shell",
        "loginShell"
      ]
    },
    "codex": {
      "type": "object",
      "properties": {
        "daemon": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "daemon",
        "cli"
      ]
    },
    "web": {
      "type": "object",
      "properties": {
        "externalOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "BAZHEN_EXTERNAL_ORIGINS",
                "config"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "allowInsecureOrigins": {
          "type": "boolean"
        },
        "pairing": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "always"
              ]
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "required"
          ]
        },
        "app": {
          "type": [
            "string",
            "null"
          ]
        },
        "lan": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "certificate": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "fingerprint": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": [
                        "fingerprint",
                        "path",
                        "expiresAt"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subnets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "interface": {
                        "type": "string"
                      },
                      "cidr": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "interface",
                      "cidr"
                    ]
                  }
                }
              },
              "required": [
                "url",
                "allow",
                "certificate",
                "error",
                "subnets"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "externalOrigins",
        "from",
        "allowInsecureOrigins"
      ]
    },
    "notifications": {
      "type": "object",
      "properties": {
        "desktop": {
          "type": "boolean"
        },
        "notifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "desktop",
        "notifier"
      ]
    },
    "terminals": {
      "type": "object",
      "properties": {
        "open": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "host": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "used": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "exact": {
                  "type": "boolean"
                }
              },
              "required": [
                "used",
                "max",
                "exact"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "refusing": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "budget",
                "host"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "open",
        "max",
        "host",
        "refusing"
      ]
    },
    "holder": {
      "type": "object",
      "properties": {
        "binary": {
          "type": [
            "string",
            "null"
          ]
        },
        "build": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "terminalId": {
                "type": "string"
              },
              "build": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "protocol": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "terminalId",
              "build",
              "protocol"
            ]
          }
        }
      },
      "required": [
        "binary",
        "build",
        "reason",
        "holders"
      ]
    },
    "env": {
      "type": "object",
      "properties": {
        "capturedAt": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "start",
            "refresh"
          ]
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removed": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "capturedAt",
        "source",
        "kept",
        "removed"
      ]
    }
  },
  "required": [
    "appVersion",
    "protocolVersion",
    "runtime",
    "hookClient",
    "config",
    "agents",
    "env"
  ]
}
