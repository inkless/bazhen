{
  "$id": "StreamServerFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "attachmentId": {
          "pattern": "^att_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        "resumeToken": {
          "type": "string"
        },
        "type": {
          "const": "attached",
          "type": "string"
        }
      },
      "required": [
        "type",
        "attachmentId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "driven": {
          "type": "boolean"
        },
        "driver": {
          "type": "boolean"
        },
        "driverDevice": {
          "type": "string"
        },
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "lease",
          "type": "string"
        }
      },
      "required": [
        "type",
        "driver",
        "epoch"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "pong",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "historyLines": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "snapshot_start",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "snapshot_end",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "geometry",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "input_dropped",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "alternate": {
          "type": "boolean"
        },
        "type": {
          "const": "screen",
          "type": "string"
        }
      },
      "required": [
        "type",
        "alternate"
      ],
      "type": "object"
    },
    {
      "properties": {
        "exit": {
          "oneOf": [
            {
              "properties": {
                "code": {
                  "format": "int64",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "type": {
                  "const": "exited",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "code"
              ],
              "type": "object"
            },
            {
              "properties": {
                "signal": {
                  "type": "string"
                },
                "type": {
                  "const": "signalled",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "signal"
              ],
              "type": "object"
            },
            {
              "properties": {
                "type": {
                  "const": "unknown",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        },
        "generation": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "exited",
          "type": "string"
        }
      },
      "required": [
        "type",
        "generation",
        "exit"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "closed",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "reason": {
          "oneOf": [
            {
              "const": "evicted_slow",
              "type": "string"
            },
            {
              "const": "disconnected",
              "type": "string"
            }
          ]
        },
        "type": {
          "const": "ended",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "type": "object"
    },
    {
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "const": "error",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "const": "notice",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    }
  ]
}
