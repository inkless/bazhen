{
  "$id": "ShellPrompt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "brackets": {
      "type": "boolean"
    }
  },
  "required": [
    "token"
  ]
}
