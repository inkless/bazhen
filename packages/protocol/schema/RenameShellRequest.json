{
  "$id": "RenameShellRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
          "x-bazhen-check": "shellName",
          "x-bazhen-transform": "trim"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "idempotencyKey",
    "name"
  ],
  "type": "object"
}
