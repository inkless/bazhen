          "required": [
            "state",
            "systemd",
            "oomPolicy",
            "terminal",
            "total",
            "swap"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "uncontained",
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "why"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "unchecked",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "env": {
      "properties": {
        "capturedAt": {
          "type": "string"
        },
        "kept": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "additionalProperties": {
            "format": "uint64",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
