{
  "name": "bazhen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:hook && pnpm --parallel --filter @bazhen/daemon --filter @bazhen/web run dev < /dev/null",
    "bazhen": "node --disable-warning=ExperimentalWarning apps/cli/src/main.ts",
    "build": "pnpm run build:hook && tsc -b && pnpm --filter @bazhen/web run build",
    "typecheck": "tsc -b",
    "lint": "node scripts/lint-config.ts --check && oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "cargo fmt --all && oxfmt",
    "format:check": "node --disable-warning=ExperimentalWarning scripts/cargo-gate.ts fmt && oxfmt --check",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:api": "pnpm run build:hook && vitest run --project api",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-standards.ts && node --disable-warning=ExperimentalWarning scripts/protocol-schema.ts --check && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run lint:rust && pnpm run deny && pnpm run test:rust && pnpm run test && pnpm run test:medium && pnpm run test:bench",
    "test:e2e": "pnpm run build:hook && pnpm --filter @bazhen/e2e-tests run test",
    "lint:config": "node scripts/lint-config.ts",
    "schema": "node --disable-warning=ExperimentalWarning scripts/protocol-schema.ts",
    "test:medium": "pnpm run build:hook && vitest run --project medium",
    "prepare": "husky",
    "test:falsify": "node scripts/falsify.ts",
    "test:file": "vitest run",
    "test:real": "node scripts/test-real.ts",
    "build:engine": "cargo build --release --quiet --locked -p bazhen-holder-engine",
    "build:hook": "cargo build --release --quiet --locked -p bazhen-hook",
    "build:notify": "node --disable-warning=ExperimentalWarning scripts/build-notify-mac.ts",
    "bench:engine": "pnpm run build:engine && node scripts/engine-replay.ts",
    "bench:hook": "node scripts/hook-bench.ts",
    "test:bench": "pnpm run build:hook && vitest run --project bench",
    "lint:rust": "node --disable-warning=ExperimentalWarning scripts/cargo-gate.ts lint",
    "test:rust": "node --disable-warning=ExperimentalWarning scripts/cargo-gate.ts test",
    "deny": "node --disable-warning=ExperimentalWarning scripts/cargo-gate.ts deny"
  },
  "devDependencies": {
    "@bazhen/host-guard": "workspace:*",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.rs": "rustfmt --edition 2024"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
