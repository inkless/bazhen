{
  "name": "bazhen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@bazhen/core": "workspace:*",
    "@bazhen/host-guard": "workspace:*",
    "@bazhen/protocol": "workspace:*",
    "@bazhen/runtime-holder": "workspace:*",
    "@types/node": "26.6.6",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "fast-check": "4.10.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.rs": "rustfmt --edition 2024"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
