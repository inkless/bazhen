{
  "$id": "WaitMessagesRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messageIds": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    }
  },
  "required": [
    "messageIds",
    "timeoutMs"
  ]
}
