{
  "$id": "HolderSetTagsRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tags": {
      "description": "Tag names __proto__, constructor, prototype are refused.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "description": "At most 64 UTF-8 bytes."
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "description": "At most 1024 UTF-8 bytes."
      }
    }
  },
  "required": [
    "tags"
  ]
}
