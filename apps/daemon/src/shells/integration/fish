# Bazhen's shell integration for fish. With `shells.retype_last_command = true` in Bazhen's
# config, source it from ~/.config/fish/config.fish:
#
#   test -n "$BAZHEN_SHELL_INTEGRATION"; and test -r "$BAZHEN_SHELL_INTEGRATION/fish"; and source "$BAZHEN_SHELL_INTEGRATION/fish"
#
# Before each line it runs, it tells Bazhen the line as you typed it, so a restart after a reboot
# can type it back at the new prompt, without Enter, which it tells Bazhen it has reached. A line
# that starts with a space is never sent. Outside a Bazhen shell with the integration on, it does
# nothing.

if set -q BAZHEN_SHELL_TOKEN; and test -x "$BAZHEN_HOOK"; and not set -q __bazhen_integrated
    set -g __bazhen_integrated 1

    function __bazhen_preexec --on-event fish_preexec
        string match -q -- ' *' $argv[1]; and return 0
        # The line goes on stdin, never as an argument: arguments show in `ps`.
        builtin printf '%s' $argv[1] | $BAZHEN_HOOK shell-report >/dev/null 2>&1 &
        disown $last_pid 2>/dev/null
        return 0
    end

    function __bazhen_report_prompt
        $BAZHEN_HOOK shell-prompt >/dev/null 2>&1 &
        disown $last_pid 2>/dev/null
    end

    # Once, at the first prompt: a restart's line is typed back from then on. fish takes the
    # terminal out of canonical mode before it draws its prompt, and asks for bracketed paste only
    # once it is drawn, so the report waits for the prompt function: for this one prompt, it runs
    # wrapped by one that reports after it, then is put back as it was.
    function __bazhen_prompt --on-event fish_prompt
        functions -e __bazhen_prompt
        if not functions -q fish_prompt; or functions -q __bazhen_user_prompt
            __bazhen_report_prompt
            return
        end
        functions -c fish_prompt __bazhen_user_prompt
        function fish_prompt
            __bazhen_user_prompt
            functions -e fish_prompt
            functions -c __bazhen_user_prompt fish_prompt
            functions -e __bazhen_user_prompt
            __bazhen_report_prompt
        end
    end
end
