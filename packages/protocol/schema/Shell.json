{
  "$id": "Shell",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "creating",
        "running",
        "exited",
        "unknown",
        "lost",
        "closing",
        "closed",
        "failed"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cwd": {
      "type": "string"
    },
    "linkedAgentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "foreground": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "command",
            "since"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "attachCommand": {
      "type": [
        "string",
        "null"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "close",
          "restart",
          "rename",
          "unlink"
        ]
      }
    }
  },
  "required": [
    "id",
    "environmentId",
    "state",
    "generation",
    "cwd",
    "linkedAgentId",
    "theme",
    "attachCommand",
    "commands"
  ]
}
