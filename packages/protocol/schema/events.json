{
  "agent.activity": {
    "entity": "agent",
    "payload": {
      "properties": {
        "confidence": {
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "detail": {
          "maxLength": 200,
          "type": "string"
        },
        "observedAt": {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "resetsAt": {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        "source": {
          "enum": [
            "native",
            "heuristic"
          ],
          "type": "string"
        },
        "value": {
          "enum": [
            "working",
            "waiting_input",
            "needs_approval",
            "idle",
            "done",
            "failed",
            "limited",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "value",
        "source",
        "confidence",
        "observedAt"
      ],
      "type": "object"
    }
  },
