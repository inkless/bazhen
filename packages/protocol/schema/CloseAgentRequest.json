{
  "$id": "CloseAgentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "force": {
      "type": "boolean"
    },
    "keepShells": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
      }
    },
    "confirmBusy": {
      "type": "boolean"
    },
    "confirmedBusy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "terminalId": {
            "type": "string",
            "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "program": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "terminalId",
          "program"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "idempotencyKey",
    "generation"
  ],
  "additionalProperties": false
}
