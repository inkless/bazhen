{
  "$id": "SignalAgentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signal": {
      "type": "string",
      "enum": [
        "SIGINT",
        "SIGTERM",
        "SIGHUP",
        "SIGKILL"
      ]
    }
  },
  "required": [
    "idempotencyKey",
    "generation",
    "signal"
  ],
  "additionalProperties": false
}
