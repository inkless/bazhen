{
  "$id": "Agent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "project": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "exited",
        "unknown",
        "lost",
        "closing",
        "closed",
        "failed"
      ]
    },
    "terminalId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "environmentId": {
              "type": "string",
              "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "claude-session",
                "codex-thread"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "environmentId",
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "environmentId",
    "harness",
    "project",
    "cwd",
    "state",
    "terminalId",
    "externalRef"
  ],
  "additionalProperties": false
}
