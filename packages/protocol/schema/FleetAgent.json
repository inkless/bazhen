{
  "$id": "FleetAgent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "name": {
      "type": "string"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "exited",
        "unknown",
        "lost",
        "closing",
        "closed",
        "failed"
      ]
    },
    "project": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "launchedBy": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "working",
                "waiting_input",
                "needs_approval",
                "idle",
                "done",
                "failed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "native",
                "heuristic"
              ]
            },
            "ageSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "value",
            "source",
            "ageSeconds"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "listening": {
      "type": "boolean"
    },
    "headline": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "taskId": {
              "type": "string",
              "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
            },
            "ageSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "text",
            "taskId",
            "ageSeconds"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "assignmentId": {
            "type": "string",
            "pattern": "^asgn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          }
        },
        "required": [
          "taskId",
          "assignmentId",
          "role"
        ]
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^attn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "approval",
              "question",
              "failed",
              "undeliverable",
              "escalation",
              "task_done"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "harness",
    "state",
    "project",
    "cwd",
    "launchedBy",
    "signal",
    "listening",
    "headline",
    "tasks",
    "attention"
  ]
}
