{
  "$id": "AddTaskNoteRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "At most 4000 UTF-8 bytes."
    },
    "handoff": {
      "type": "boolean"
    }
  },
  "required": [
    "idempotencyKey",
    "text"
  ]
}
