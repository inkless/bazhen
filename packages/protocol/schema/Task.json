{
  "$id": "Task",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "cancelled"
      ]
    },
    "ownerAgentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parentTaskId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "state",
    "ownerAgentId",
    "parentTaskId"
  ],
  "additionalProperties": false
}
