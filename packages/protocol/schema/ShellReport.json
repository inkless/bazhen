{
  "$id": "ShellReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "at": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "command": {
      "maxLength": 2048,
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "token",
    "at",
    "command"
  ],
  "type": "object"
}
