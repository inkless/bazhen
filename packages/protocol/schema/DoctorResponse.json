{
  "$id": "DoctorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentCli": {
      "properties": {
        "expected": {
          "type": [
            "string",
            "null"
          ]
        },
        "onPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "expected",
        "onPath"
      ],
      "type": "object"
    },
    "agents": {
      "properties": {
        "loginShell": {
          "type": [
            "string",
            "null"
          ]
        },
        "shell": {
          "enum": [
            "direct",
            "login"
          ],
          "type": "string"
        }
      },
      "required": [
        "shell",
        "loginShell"
      ],
      "type": "object"
    },
    "appVersion": {
      "type": "string"
    },
    "codex": {
      "properties": {
        "cli": {
          "type": [
            "string",
            "null"
          ]
        },
        "daemon": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolCalls": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "const": "marked",
                  "type": "string"
                },
                {
                  "const": "unmarked",
                  "type": "string"
                },
                {
                  "const": "unread",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "daemon",
        "cli"
      ],
      "type": "object"
