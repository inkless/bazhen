{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "react",
    "react-hooks",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "import/no-cycle": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/expect-expect": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-conditional-in-test": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-standalone-expect": "error",
    "no-console": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/protocol/**/*.ts",
        "packages/protocol/**/*.tsx"
      ],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bazhen/core",
                  "@bazhen/core/**",
                  "**/packages/core/**",
                  "**/core/src/**"
                ],
                "message": "packages/protocol (tech-stack-and-scaffold.md §3, docs/standards/code.md) must not import @bazhen/core."
              },
              {
                "group": [
                  "@bazhen/runtime-tmux",
                  "@bazhen/runtime-tmux/**",
                  "**/packages/runtime-tmux/**",
                  "**/runtime-tmux/src/**"
                ],
                "message": "packages/protocol (tech-stack-and-scaffold.md §3, docs/standards/code.md) must not import @bazhen/runtime-tmux."
              },
              {
                "group": [
                  "@bazhen/daemon",
                  "@bazhen/daemon/**",
                  "**/apps/daemon/**",
                  "**/daemon/src/**"
                ],
                "message": "packages/protocol (tech-stack-and-scaffold.md §3, docs/standards/code.md) must not import @bazhen/daemon."
              },
              {
                "group": [
                  "@bazhen/web",
                  "@bazhen/web/**",
                  "**/apps/web/**",
                  "**/web/src/**"
                ],
                "message": "packages/protocol (tech-stack-and-scaffold.md §3, docs/standards/code.md) must not import @bazhen/web."
              },
              {
                "group": [
                  "node-pty",
                  "hono",
                  "@hono/*",
                  "ws",
                  "@xterm/*"
                ],
                "message": "packages/protocol (tech-stack-and-scaffold.md §3, docs/standards/code.md) must not import runtime libraries."
              }
            ]
          }
        ]
      }
    },
