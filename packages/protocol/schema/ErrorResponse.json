{
  "$id": "ErrorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported",
        "launch_failed",
        "conflict",
        "stale_generation",
        "not_resumable",
        "unavailable",
        "server_unconfirmed",
        "busy",
        "not_found",
        "origin_not_allowed",
        "host_not_allowed",
        "forbidden",
        "unpaired",
        "pairing_failed",
        "rate_limited"
      ]
    },
    "message": {
      "type": "string"
    },
    "busy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "terminalId": {
            "type": "string",
            "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "program": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "terminalId",
          "program"
        ]
      }
    }
  },
  "required": [
    "error",
    "message"
  ]
}
