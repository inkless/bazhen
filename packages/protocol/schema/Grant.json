{
  "$id": "Grant",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentId": {
      "anyOf": [
        {
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "pattern": "^(?!(?:host|env|agent|task|asgn|attn|ntc|msg|term|dev|att|lease|obs)_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$)[A-Za-z0-9][A-Za-z0-9_-]{0,39}$",
          "type": "string"
        }
      ]
    },
    "role": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "type": "string"
    }
  },
  "required": [
    "agentId",
    "role"
  ],
  "type": "object"
}
