{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "node_modules/.cache/tsc-dev",
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "apps/daemon/src/**/*.test.ts",
    "apps/cli/src/**/*.test.ts",
    "tests/support/*.ts",
    "scripts/*.ts"
  ],
  "references": [
    {
      "path": "packages/protocol"
    },
    {
      "path": "packages/core"
    },
    {
      "path": "packages/host-guard"
    },
    {
      "path": "packages/runtime-tmux"
    },
    {
      "path": "packages/env-local"
    },
    {
      "path": "packages/harness-claude-code"
    },
    {
      "path": "packages/harness-codex"
    },
    {
      "path": "apps/daemon"
    },
    {
      "path": "apps/cli"
    }
  ]
}
