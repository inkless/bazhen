{
  "$id": "ResendAttentionResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "eventIds": {
      "items": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "messageId": {
      "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    }
  },
  "required": [
    "messageId",
    "eventIds"
  ],
  "type": "object"
}
