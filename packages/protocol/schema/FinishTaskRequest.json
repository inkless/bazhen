{
  "$id": "FinishTaskRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cascade": {
      "type": "boolean"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "note": {
      "maxLength": 20000,
      "type": "string",
      "x-bazhen-check": "noteText"
    },
    "outcome": {
      "enum": [
        "done",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey",
    "outcome"
  ],
  "type": "object"
}
