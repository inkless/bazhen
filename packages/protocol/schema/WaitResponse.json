{
  "$id": "WaitResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agent": {
      "properties": {
        "activity": {
          "properties": {
            "confidence": {
              "format": "double",
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "detail": {
              "maxLength": 200,
              "type": "string"
            },
            "observedAt": {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "resetsAt": {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "source": {
              "enum": [
                "native",
                "heuristic"
              ],
              "type": "string"
            },
            "value": {
              "enum": [
                "working",
                "waiting_input",
                "needs_approval",
                "idle",
                "done",
                "failed",
                "limited",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "value",
            "source",
            "confidence",
            "observedAt"
          ],
          "type": "object"
        },
        "attachCommand": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "canOpenShell": {
          "default": false,
          "type": "boolean"
        },
        "commands": {
          "default": [],
          "items": {
            "enum": [
              "close",
              "respawn",
              "signal",
              "relaunch"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "environmentId": {
          "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        "exit": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "properties": {
                    "code": {
                      "format": "int64",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "type": {
                      "const": "exited",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "code"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "signal": {
                      "type": "string"
                    },
                    "type": {
                      "const": "signalled",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "signal"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "type": {
                      "const": "unknown",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "type": "object"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "externalRef": {
          "anyOf": [
            {
              "properties": {
                "environmentId": {
                  "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
                  "type": "string"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "claude-session",
                    "codex-thread"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "environmentId",
                "kind",
                "id"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "harness": {
          "enum": [
            "claude-code",
            "codex"
          ],
          "type": "string"
        },
        "headline": {
          "anyOf": [
            {
              "properties": {
                "at": {
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                },
                "taskId": {
                  "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text",
                "taskId",
                "at"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        "launchedBy": {
          "default": null,
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": [
            "string",
            "null"
          ]
        },
        "listening": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "needsRestart": {
          "anyOf": [
            {
              "properties": {
                "holderPid": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "served": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "holderPid"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project": {
          "type": "string"
        },
        "promptChanged": {
          "default": false,
          "type": "boolean"
        },
        "resumable": {
          "default": false,
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "startRequestedAt": {
          "anyOf": [
            {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "starting",
            "running",
            "exited",
            "unknown",
            "lost",
            "closing",
            "closed",
            "failed"
          ],
          "type": "string"
        },
        "terminalId": {
          "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "default": "dark",
          "enum": [
            "light",
            "dark"
          ],
          "type": "string"
        },
        "themes": {
          "default": [
            "dark"
          ],
          "items": {
            "enum": [
              "light",
              "dark"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "usage": {
          "properties": {
            "contextUsedPercent": {
              "format": "double",
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "contextWindowTokens": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "limits": {
              "items": {
                "properties": {
                  "resetsAt": {
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "type": "string"
                  },
                  "usedPercent": {
                    "format": "double",
                    "minimum": 0,
                    "type": "number"
                  },
                  "window": {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "window",
                  "usedPercent"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "type": "array"
            },
            "model": {
              "maxLength": 200,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "environmentId",
        "harness",
        "project",
        "cwd",
        "state",
        "terminalId",
        "generation",
        "externalRef",
        "exit"
      ],
      "type": "object"
    },
    "replyId": {
      "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "said": {
      "type": "string"
    },
    "shell": {
      "properties": {
        "attachCommand": {
          "type": [
            "string",
            "null"
          ]
        },
        "commands": {
          "items": {
            "enum": [
              "close",
              "restart",
              "rename",
              "unlink"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "environmentId": {
          "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        "foreground": {
          "anyOf": [
            {
              "properties": {
                "command": {
                  "type": "string"
                },
                "since": {
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "type": "string"
                }
              },
              "required": [
                "command",
                "since"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generation": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        "linkedAgentId": {
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "needsRestart": {
          "anyOf": [
            {
              "properties": {
                "holderPid": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "served": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "holderPid"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retypeable": {
          "default": false,
          "type": "boolean"
        },
        "state": {
          "enum": [
            "creating",
            "running",
            "exited",
            "unknown",
            "lost",
            "closing",
            "closed",
            "failed"
          ],
          "type": "string"
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "environmentId",
        "state",
        "generation",
        "cwd",
        "linkedAgentId",
        "theme",
        "attachCommand",
        "commands"
      ],
      "type": "object"
    },
    "task": {
      "properties": {
        "id": {
          "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        "ownerAgentId": {
          "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": [
            "string",
            "null"
          ]
        },
        "parentTaskId": {
          "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "open",
            "done",
            "cancelled"
          ],
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "state",
        "ownerAgentId",
        "parentTaskId"
      ],
      "type": "object"
    },
    "verdict": {
      "oneOf": [
        {
          "enum": [
            "met"
          ],
          "type": "string"
        },
        {
          "const": "never",
          "type": "string"
        },
        {
          "const": "bounced",
          "type": "string"
        },
        {
          "const": "pending",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "verdict",
    "said"
  ],
  "type": "object"
}
