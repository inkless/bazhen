{
  "$id": "HolderTags",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "type": "string",
    "x-bazhen-check": [
      "wellFormed",
      "utf8AtMost1024Bytes"
    ]
  },
  "propertyNames": {
    "minLength": 1,
    "pattern": "^(?!(?:__proto__|constructor|prototype)$)",
    "type": "string",
    "x-bazhen-check": [
      "wellFormed",
      "utf8AtMost64Bytes"
    ]
  },
  "type": "object",
  "x-bazhen-transform": "refusingOwnProto"
}
