      "required": [
        "path",
        "found"
      ],
      "type": "object"
    },
    "containment": {
      "oneOf": [
        {
          "properties": {
            "oomPolicy": {
              "type": "boolean"
            },
            "state": {
              "const": "scoped",
              "type": "string"
            },
            "swap": {
              "properties": {
                "asked": {
                  "type": "string"
                },
                "bytes": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "asked",
                "bytes"
              ],
              "type": "object"
            },
            "systemd": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "terminal": {
              "properties": {
                "asked": {
                  "type": "string"
                },
                "bytes": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "asked",
                "bytes"
              ],
              "type": "object"
            },
            "total": {
              "properties": {
                "asked": {
                  "type": "string"
                },
                "bytes": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "asked",
                "bytes"
              ],
              "type": "object"
