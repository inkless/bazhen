{
  "$id": "ExitStatus",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exited"
        },
        "code": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signalled"
        },
        "signal": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "signal"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "unknown"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
