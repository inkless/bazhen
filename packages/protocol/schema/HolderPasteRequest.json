{
  "$id": "HolderPasteRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "brackets": {
      "type": "boolean"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "text": {
      "type": "string",
      "x-bazhen-check": [
        "wellFormed",
        "noControl"
      ]
    }
  },
  "required": [
    "generation",
    "text",
    "brackets"
  ],
  "type": "object",
  "x-bazhen-check": "unmarkedPasteIsAscii"
}
