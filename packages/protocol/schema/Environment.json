{
  "$id": "Environment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "host": {
      "default": "",
      "type": "string"
    },
    "id": {
      "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "local",
        "opencode-server"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "type": "object"
}
