{
  "$id": "HolderStats",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "engineBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rss": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "ringBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "historyLines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "engineBytes",
    "rss",
    "ringBytes",
    "historyLines"
  ],
  "additionalProperties": false
}
