#!/bin/sh
# Tiered local gate (docs/standards/review.md). There is no CI yet. The tiers are defined, and
# tested, in scripts/precommit-tier.ts.
set -eu

tier=$(node --disable-warning=ExperimentalWarning scripts/precommit-tier.ts)
case "$tier" in
  docs)
    node --disable-warning=ExperimentalWarning scripts/check-standards.ts
    exec pnpm format:check
    ;;
  fast) exec pnpm check:fast ;;
  full)
    pnpm check:fast
    exec pnpm test:integration
    ;;
  *)
    echo "pre-commit: unknown tier \"$tier\"" >&2
    exit 1
    ;;
esac
