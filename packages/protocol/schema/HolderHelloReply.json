{
  "$id": "HolderHelloReply",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$"
      }
    },
    "terminalId": {
      "type": "string",
      "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "tags": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "holderPid": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "holderStart": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "childPid": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "exit": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "exited"
                },
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "code"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "signalled"
                },
                "signal": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "signal"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "unknown"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "size": {
      "type": "object",
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "additionalProperties": false
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string"
    },
    "alternate": {
      "type": "boolean"
    },
    "historyLines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "writer": {
      "type": "boolean"
    }
  },
  "required": [
    "protocol",
    "terminalId",
    "tags",
    "generation",
    "holderPid",
    "holderStart",
    "childPid",
    "exit",
    "size",
    "offset",
    "title",
    "alternate",
    "historyLines",
    "writer"
  ],
  "additionalProperties": false
}
