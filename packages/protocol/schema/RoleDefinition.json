{
  "$id": "RoleDefinition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      }
    },
    "singlePerTask": {
      "type": "boolean"
    },
    "maxActiveTasks": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "builtin",
        "user"
      ]
    }
  },
  "required": [
    "key",
    "title",
    "description",
    "grants",
    "singlePerTask",
    "maxActiveTasks",
    "prompt",
    "source"
  ]
}
