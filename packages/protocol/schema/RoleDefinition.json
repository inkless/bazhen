{
  "$id": "RoleDefinition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "type": "string"
    },
    "grants": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$",
        "type": "string"
      },
      "type": "array"
    },
    "key": {
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "maxActiveTasks": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "singlePerTask": {
      "type": "boolean"
    },
    "source": {
      "enum": [
        "builtin",
        "user"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "title",
    "description",
    "grants",
    "singlePerTask",
    "maxActiveTasks",
    "prompt",
    "source"
  ],
  "type": "object"
}
