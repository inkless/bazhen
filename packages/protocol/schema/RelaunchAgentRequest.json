{
  "$id": "RelaunchAgentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "fresh": {
      "type": "boolean"
    },
    "generation": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey",
    "generation"
  ],
  "type": "object"
}
