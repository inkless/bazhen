{
  "$id": "StreamClientFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "observe",
            "interactive"
          ],
          "type": "string"
        },
        "protocolId": {
          "type": "string"
        },
        "resumes": {
          "properties": {
            "attachmentId": {
              "pattern": "^att_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            "token": {
              "maxLength": 64,
              "type": "string"
            }
          },
          "required": [
            "attachmentId",
            "token"
          ],
          "type": "object"
        },
        "rows": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        "type": {
          "const": "hello",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mode",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        "type": {
          "const": "resize",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "engage",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "epoch",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "ping",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ]
}
