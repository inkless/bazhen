{
  "$id": "Message",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "offered",
        "emitted",
        "seen",
        "queued_in_codex",
        "delivered",
        "undeliverable"
      ]
    }
  },
  "required": [
    "id",
    "agentId",
    "state"
  ]
}
