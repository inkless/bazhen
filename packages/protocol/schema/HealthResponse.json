{
  "$id": "HealthResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "appVersion": {
      "type": "string"
    },
    "protocolId": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tmux"
        },
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "unreachable",
            "not-running"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "state",
        "version"
      ]
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "healthy",
              "unreachable",
              "not-running"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "workarounds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "state",
          "version"
        ]
      }
    }
  },
  "required": [
    "status",
    "appVersion",
    "protocolId",
    "runtime"
  ]
}
