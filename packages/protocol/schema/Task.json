{
  "$id": "Task",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "ownerAgentId": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": [
        "string",
        "null"
      ]
    },
    "parentTaskId": {
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "open",
        "done",
        "cancelled"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "state",
    "ownerAgentId",
    "parentTaskId"
  ],
  "type": "object"
}
