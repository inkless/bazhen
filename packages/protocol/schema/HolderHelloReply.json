{
  "$id": "HolderHelloReply",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alternate": {
      "type": "boolean"
    },
    "childPid": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "childStart": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "engine": {
      "type": "boolean"
    },
    "exit": {
      "anyOf": [
        {
          "oneOf": [
            {
              "properties": {
                "code": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "type": {
                  "const": "exited",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "code"
              ],
              "type": "object"
            },
            {
              "properties": {
                "signal": {
                  "type": "string",
                  "x-bazhen-check": "wellFormed"
                },
                "type": {
                  "const": "signalled",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "signal"
              ],
              "type": "object"
            },
            {
              "properties": {
                "type": {
                  "const": "unknown",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "historyLines": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "holderPid": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "holderStart": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "offset": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "protocol": {
      "items": {
        "type": "string",
        "x-bazhen-check": [
          "wellFormed",
          "utf8AtMost32Bytes"
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "size": {
      "properties": {
        "cols": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "tags": {
      "additionalProperties": {
        "type": "string",
        "x-bazhen-check": [
          "wellFormed",
          "utf8AtMost1024Bytes"
        ]
      },
      "propertyNames": {
        "minLength": 1,
        "pattern": "^(?!(?:__proto__|constructor|prototype)$)",
        "type": "string",
        "x-bazhen-check": [
          "wellFormed",
          "utf8AtMost64Bytes"
        ]
      },
      "type": "object",
      "x-bazhen-transform": "refusingOwnProto"
    },
    "terminalId": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "title": {
      "type": "string",
      "x-bazhen-check": "wellFormed"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "writer": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "protocol",
    "terminalId",
    "tags",
    "generation",
    "holderPid",
    "holderStart",
    "childPid",
    "childStart",
    "exit",
    "size",
    "offset",
    "title",
    "alternate",
    "historyLines",
    "writer"
  ],
  "type": "object"
}
