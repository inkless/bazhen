  "agent.compacted": {
    "entity": "agent",
    "payload": {
      "properties": {
        "before": {
          "properties": {
            "contextUsedPercent": {
              "format": "double",
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "contextWindowTokens": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "limits": {
              "items": {
                "properties": {
                  "resetsAt": {
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "type": "string"
                  },
                  "usedPercent": {
                    "format": "double",
                    "minimum": 0,
                    "type": "number"
                  },
                  "window": {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "window",
                  "usedPercent"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "type": "array"
            },
            "model": {
              "maxLength": 200,
              "type": "string"
            }
          },
          "type": "object"
        },
        "hook": {
          "properties": {
            "pid": {
              "format": "int64",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "sessionId",
            "pid"
          ],
          "type": "object"
        },
        "sign": {
          "enum": [
            "claude_hook",
            "codex_item"
          ],
          "type": "string"
        }
      },
      "required": [
        "sign"
      ],
      "type": "object"
    }
  },
