{
  "$id": "UnassignTaskRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignmentId": {
      "pattern": "^asgn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey",
    "assignmentId"
  ],
  "type": "object"
}
