{
  "$id": "AddTaskNoteRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "handoff": {
      "type": "boolean"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "type": "string",
      "x-bazhen-check": [
        "taskNoteBytes",
        "noteText"
      ],
      "x-bazhen-transform": "trim"
    }
  },
  "required": [
    "idempotencyKey",
    "text"
  ],
  "type": "object"
}
