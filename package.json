{
  "name": "bazhen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @bazhen/daemon --filter @bazhen/web run dev",
    "build": "tsc -b && pnpm --filter @bazhen/web run build",
    "typecheck": "tsc -b",
    "lint": "node scripts/lint-config.ts --check && oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-standards.ts && node scripts/protocol-schema.ts --check && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run test:medium && pnpm run test:integration",
    "test:e2e": "pnpm --filter @bazhen/e2e-tests run test",
    "lint:config": "node scripts/lint-config.ts",
    "schema": "node scripts/protocol-schema.ts",
    "test:medium": "vitest run --project medium",
    "prepare": "husky",
    "test:falsify": "node scripts/falsify.ts",
    "test:file": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
