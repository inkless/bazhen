{
  "$id": "TerminalScreen",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "history": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "text": {
      "type": "string",
      "x-bazhen-check": [
        "wellFormed",
        "screenText"
      ]
    }
  },
  "required": [
    "text",
    "history"
  ],
  "type": "object"
}
