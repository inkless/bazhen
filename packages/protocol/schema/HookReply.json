{
  "$id": "HookReply",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "exitCode": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "offered": {
      "items": {
        "pattern": "^msg_[0-9a-f]{32}-[0-9a-z]{1,32}$",
        "type": "string"
      },
      "type": "array"
    },
    "stderr": {
      "type": "string"
    },
    "stdout": {
      "type": "string"
    }
  },
  "required": [
    "exitCode",
    "stdout",
    "stderr",
    "offered"
  ],
  "type": "object"
}
