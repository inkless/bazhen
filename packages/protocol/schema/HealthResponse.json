{
  "$id": "HealthResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "appVersion": {
      "type": "string"
    },
    "protocolId": {
      "type": "string"
    },
    "runtimes": {
      "items": {
        "properties": {
          "kind": {
            "type": "string"
          },
          "state": {
            "enum": [
              "healthy",
              "unreachable",
              "not-running",
              "unused"
            ],
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "workarounds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "state",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "ok"
      ],
      "type": "string"
    }
  },
  "required": [
    "status",
    "appVersion",
    "protocolId",
    "runtimes"
  ],
  "type": "object"
}
