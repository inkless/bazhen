{
  "$id": "WaitMessagesRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "messageIds": {
      "items": {
        "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "timeoutMs": {
      "format": "uint64",
      "maximum": 600000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "messageIds",
    "timeoutMs"
  ],
  "type": "object"
}
