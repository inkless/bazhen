{
  "$id": "HolderSpawnSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "argv": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "protocol": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "terminalId": {
      "type": "string",
      "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "socket": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "size": {
      "type": "object",
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "additionalProperties": false
    },
    "historyLines": {
      "default": 10000,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "argv",
    "cwd",
    "env",
    "generation",
    "protocol",
    "terminalId",
    "socket",
    "tags",
    "size"
  ],
  "additionalProperties": false
}
