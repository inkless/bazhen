{
  "$id": "ErrorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "busy": {
      "items": {
        "properties": {
          "program": {
            "maxLength": 200,
            "type": "string"
          },
          "terminalId": {
            "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          }
        },
        "required": [
          "terminalId",
          "program"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "error": {
      "enum": [
        "invalid_request",
        "unsupported",
        "launch_failed",
        "conflict",
        "stale_generation",
        "not_resumable",
        "unavailable",
        "server_unconfirmed",
        "needs_restart",
        "busy",
        "not_found",
        "origin_not_allowed",
        "host_not_allowed",
        "forbidden",
        "unpaired",
        "pairing_failed",
        "rate_limited",
        "terminal_limit"
      ],
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "error",
    "message"
  ],
  "type": "object"
}
