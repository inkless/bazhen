{
  "$id": "ShellReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "command": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "token",
    "at",
    "command"
  ]
}
