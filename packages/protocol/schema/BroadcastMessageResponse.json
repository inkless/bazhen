{
  "$id": "BroadcastMessageResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "eventIds": {
      "items": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "sent": {
      "items": {
        "properties": {
          "agentId": {
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          },
          "messageId": {
            "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          }
        },
        "required": [
          "agentId",
          "messageId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "skipped": {
      "items": {
        "properties": {
          "agentId": {
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "agentId",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "sent",
    "skipped",
    "eventIds"
  ],
  "type": "object"
}
