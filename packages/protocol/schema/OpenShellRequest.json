{
  "$id": "OpenShellRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cwd": {
      "minLength": 1,
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "linkedAgentId": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey"
  ],
  "type": "object",
  "x-bazhen-check": "linkedShellTakesNoCwd"
}
