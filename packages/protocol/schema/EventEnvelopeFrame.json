{
  "$id": "EventEnvelopeFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "event": {
          "properties": {
            "actor": {
              "type": "string"
            },
            "causationId": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "correlationId": {
              "type": [
                "string",
                "null"
              ]
            },
            "entityId": {
              "type": "string"
            },
            "entityType": {
              "type": "string"
            },
            "id": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "payload": true,
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "ts",
            "type",
            "entityType",
            "entityId",
            "actor",
            "causationId",
            "correlationId",
            "payload"
          ],
          "type": "object"
        },
        "type": {
          "const": "event",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event"
      ],
      "type": "object"
    },
    {
      "properties": {
        "reason": {
          "enum": [
            "stale",
            "foreign"
          ],
          "type": "string"
        },
        "type": {
          "const": "reset",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "type": "object"
    }
  ]
}
