{
  "$id": "HolderHelloReplyFrozen",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "protocol": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "description": "At most 32 UTF-8 bytes."
      }
    }
  },
  "required": [
    "version",
    "protocol"
  ]
}
