{
  "$id": "StateSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string"
    },
    "eventId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "local",
              "opencode-server"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "environmentId": {
            "type": "string",
            "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex"
            ]
          },
          "project": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "starting",
              "running",
              "exited",
              "unknown",
              "lost",
              "closing",
              "closed",
              "failed"
            ]
          },
          "terminalId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "generation": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "externalRef": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "environmentId": {
                    "type": "string",
                    "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "claude-session",
                      "codex-thread"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "environmentId",
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "exit": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "exited"
                      },
                      "code": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "type",
                      "code"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "signalled"
                      },
                      "signal": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "signal"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "unknown"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "activity": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "working",
                  "waiting_input",
                  "needs_approval",
                  "idle",
                  "done",
                  "failed",
                  "unknown"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "native",
                  "heuristic"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "detail": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "value",
              "source",
              "confidence",
              "observedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "environmentId",
          "harness",
          "project",
          "cwd",
          "state",
          "terminalId",
          "generation",
          "externalRef",
          "exit"
        ],
        "additionalProperties": false
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^attn_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "agentId": {
            "type": "string",
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "closeReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answered",
                  "answered_in_tui",
                  "timed_out",
                  "superseded",
                  "agent_closed",
                  "stale"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "agentId",
          "state",
          "closeReason",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "agentId": {
            "type": "string",
            "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "offered",
              "emitted",
              "seen",
              "queued_in_codex",
              "delivered",
              "undeliverable"
            ]
          }
        },
        "required": [
          "id",
          "agentId",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "epoch",
    "eventId",
    "environments",
    "agents",
    "attention",
    "messages"
  ],
  "additionalProperties": false
}
