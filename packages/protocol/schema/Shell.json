{
  "$id": "Shell",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attachCommand": {
      "type": [
        "string",
        "null"
      ]
    },
    "commands": {
      "items": {
        "enum": [
          "close",
          "restart",
          "rename",
          "unlink"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "cwd": {
      "type": "string"
    },
    "environmentId": {
      "pattern": "^env_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "foreground": {
      "anyOf": [
        {
          "properties": {
            "command": {
              "type": "string"
            },
            "since": {
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            }
          },
          "required": [
            "command",
            "since"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "linkedAgentId": {
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "needsRestart": {
      "anyOf": [
        {
          "properties": {
            "holderPid": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "served": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "holderPid"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retypeable": {
      "default": false,
      "type": "boolean"
    },
    "state": {
      "enum": [
        "creating",
        "running",
        "exited",
        "unknown",
        "lost",
        "closing",
        "closed",
        "failed"
      ],
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "environmentId",
    "state",
    "generation",
    "cwd",
    "linkedAgentId",
    "theme",
    "attachCommand",
    "commands"
  ],
  "type": "object"
}
