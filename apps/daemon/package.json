    "@bazhen/protocol": "workspace:*",
    "@bazhen/runtime-tmux": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "hono": "4.13.16",
    "node-pty": "1.2.0-beta.18",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
