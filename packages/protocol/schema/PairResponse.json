{
  "$id": "PairResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "deviceId",
    "name"
  ],
  "additionalProperties": false
}
