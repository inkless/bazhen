{
  "$id": "SignalAgentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "generation": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "signal": {
      "enum": [
        "SIGINT",
        "SIGTERM",
        "SIGHUP",
        "SIGKILL"
      ],
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey",
    "generation",
    "signal"
  ],
  "type": "object"
}
