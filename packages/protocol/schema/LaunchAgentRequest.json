{
  "$id": "LaunchAgentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "cwd": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "project": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "idempotencyKey",
    "harness",
    "cwd"
  ],
  "additionalProperties": false
}
