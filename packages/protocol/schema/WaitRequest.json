{
  "$id": "WaitRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "condition": {
      "oneOf": [
        {
          "properties": {
            "agentId": {
              "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            "on": {
              "const": "agent",
              "type": "string"
            },
            "until": {
              "enum": [
                "starting",
                "running",
                "exited",
                "unknown",
                "lost",
                "closing",
                "closed",
                "failed",
                "ended",
                "ready",
                "idle"
              ],
              "type": "string"
            }
          },
          "required": [
            "on",
            "agentId",
            "until"
          ],
          "type": "object"
        },
        {
          "properties": {
            "on": {
              "const": "shell",
              "type": "string"
            },
            "shellId": {
              "pattern": "^term_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            "until": {
              "enum": [
                "creating",
                "running",
                "exited",
                "unknown",
                "lost",
                "closing",
                "closed",
                "failed",
                "ended"
              ],
              "type": "string"
            }
          },
          "required": [
            "on",
            "shellId",
            "until"
          ],
          "type": "object"
        },
        {
          "properties": {
            "on": {
              "const": "task",
              "type": "string"
            },
            "taskId": {
              "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            "until": {
              "enum": [
                "done"
              ],
              "type": "string"
            }
          },
          "required": [
            "on",
            "taskId",
            "until"
          ],
          "type": "object"
        },
        {
          "properties": {
            "messageId": {
              "pattern": "^msg_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            "on": {
              "const": "reply",
              "type": "string"
            }
          },
          "required": [
            "on",
            "messageId"
          ],
          "type": "object"
        }
      ]
    },
    "resumed": {
      "type": "boolean"
    },
    "timeoutMs": {
      "format": "uint64",
      "maximum": 600000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "condition",
    "timeoutMs"
  ],
  "type": "object"
}
