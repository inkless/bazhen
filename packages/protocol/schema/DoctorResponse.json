{
  "$id": "DoctorResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "appVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "unreachable",
            "not-running"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "version"
      ],
      "additionalProperties": false
    },
    "hookClient": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "fallback"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "found": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "found"
      ],
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "string",
          "enum": [
            "direct",
            "login"
          ]
        },
        "loginShell": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "shell",
        "loginShell"
      ],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "properties": {
        "capturedAt": {
          "type": "string"
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removed": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "capturedAt",
        "kept",
        "removed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "appVersion",
    "protocolVersion",
    "runtime",
    "hookClient",
    "config",
    "agents",
    "env"
  ],
  "additionalProperties": false
}
