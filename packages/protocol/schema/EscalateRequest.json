{
  "$id": "EscalateRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string",
      "x-bazhen-transform": "trim"
    },
    "taskId": {
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    }
  },
  "required": [
    "idempotencyKey",
    "summary"
  ],
  "type": "object"
}
