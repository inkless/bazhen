                    "required": [
                      "engineBytes",
                      "rss",
                      "ringBytes",
                      "historyLines"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "terminalId": {
                "type": "string"
              }
            },
            "required": [
              "terminalId",
              "build",
              "protocol"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "binary",
        "build",
        "reason",
        "holders"
      ],
      "type": "object"
    },
    "hookClient": {
      "properties": {
        "fallback": {
          "type": "boolean"
