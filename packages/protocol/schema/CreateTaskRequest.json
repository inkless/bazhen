{
  "$id": "CreateTaskRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assign": {
      "properties": {
        "agentId": {
          "anyOf": [
            {
              "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
              "type": "string"
            },
            {
              "pattern": "^(?!(?:host|env|agent|task|asgn|attn|ntc|msg|term|dev|att|lease|obs)_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$)[A-Za-z0-9][A-Za-z0-9_-]{0,39}$",
              "type": "string"
            }
          ]
        },
        "role": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": "string"
        }
      },
      "required": [
        "agentId",
        "role"
      ],
      "type": "object"
    },
    "brief": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "parentTaskId": {
      "pattern": "^task_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string",
      "x-bazhen-check": "newTaskTitle",
      "x-bazhen-transform": "trim"
    }
  },
  "required": [
    "idempotencyKey",
    "title",
    "brief"
  ],
  "type": "object"
}
