{
  "$id": "HookRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "ppid": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "payload": {}
  },
  "required": [
    "protocolVersion",
    "agentId",
    "event",
    "pid",
    "ppid",
    "payload"
  ],
  "additionalProperties": false
}
