{
  "$id": "HolderSpawnSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "argv": {
      "items": {
        "type": "string",
        "x-bazhen-check": "wellFormed"
      },
      "minItems": 1,
      "type": "array"
    },
    "cwd": {
      "minLength": 1,
      "type": "string",
      "x-bazhen-check": [
        "wellFormed"
      ]
    },
    "env": {
      "additionalProperties": {
        "type": "string",
        "x-bazhen-check": "wellFormed"
      },
      "propertyNames": {
        "pattern": "^(?!(?:__proto__)$)",
        "type": "string",
        "x-bazhen-check": "wellFormed"
      },
      "type": "object",
      "x-bazhen-transform": "refusingOwnProto"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "historyLines": {
      "default": 10000,
      "maximum": 100000,
      "minimum": 0,
      "type": "integer"
    },
    "protocol": {
      "items": {
        "type": "string",
        "x-bazhen-check": [
          "wellFormed",
          "utf8AtMost32Bytes"
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "size": {
      "properties": {
        "cols": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "socket": {
      "minLength": 1,
      "type": "string",
      "x-bazhen-check": [
        "wellFormed"
      ]
    },
    "tags": {
      "additionalProperties": {
        "type": "string",
        "x-bazhen-check": [
          "wellFormed",
          "utf8AtMost1024Bytes"
        ]
      },
      "propertyNames": {
        "minLength": 1,
        "pattern": "^(?!(?:__proto__|constructor|prototype)$)",
        "type": "string",
        "x-bazhen-check": [
          "wellFormed",
          "utf8AtMost64Bytes"
        ]
      },
      "type": "object",
      "x-bazhen-transform": "refusingOwnProto"
    },
    "terminalId": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    }
  },
  "required": [
    "argv",
    "cwd",
    "env",
    "generation",
    "protocol",
    "terminalId",
    "socket",
    "tags",
    "size"
  ],
  "type": "object"
}
