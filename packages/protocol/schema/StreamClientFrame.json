{
  "$id": "StreamClientFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocolVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "interactive"
          ]
        },
        "cols": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "mode",
        "cols",
        "rows"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resize"
        },
        "cols": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "cols",
        "rows"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "engage"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
