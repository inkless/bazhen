{
  "$id": "HolderProcessSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "argv": {
      "items": {
        "type": "string",
        "x-bazhen-check": "wellFormed"
      },
      "minItems": 1,
      "type": "array"
    },
    "cwd": {
      "minLength": 1,
      "type": "string",
      "x-bazhen-check": [
        "wellFormed"
      ]
    },
    "env": {
      "additionalProperties": {
        "type": "string",
        "x-bazhen-check": "wellFormed"
      },
      "propertyNames": {
        "pattern": "^(?!(?:__proto__)$)",
        "type": "string",
        "x-bazhen-check": "wellFormed"
      },
      "type": "object",
      "x-bazhen-transform": "refusingOwnProto"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    }
  },
  "required": [
    "argv",
    "cwd",
    "env",
    "generation"
  ],
  "type": "object"
}
